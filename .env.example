# === Postgres local (docker-compose.yml, servico "db") ===
# Usadas tambem pelo backend (DATABASE_USER/DATABASE_PASSWORD/DATABASE_NAME apontam
# para estes mesmos valores). Credenciais de dev local, troque para qualquer valor.
POSTGRES_USER=cortepolitico
POSTGRES_PASSWORD=
POSTGRES_DB=cortepolitico

# === AWS (docker-compose.yml, servico "backend") ===
# Perfil AWS CLI/SSO configurado na maquina host (~/.aws), montado read-only no
# container. Configure com `aws configure sso --profile <nome>`.
AWS_PROFILE=
AWS_REGION=us-east-2

# === Cognito (User Pool provisionado na conta AWS do projeto) ===
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# === Secrets Manager (segredo com as chaves de API do backend) ===
SECRETS_MANAGER_SECRET_ID=
