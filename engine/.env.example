# === LLM de TEXTO do motor (selecao de trechos, rerank, titulo/descricao/hashtags) ===

# Qual provedor de IA o motor usa para as etapas de TEXTO: "claude" (padrao) ou "gemini".
# A geracao de IMAGEM da thumbnail (Nano Banana) e SEMPRE Gemini e nao depende desta
# variavel - so a parte de texto e configuravel aqui.
CLIPADOR_TEXT_LLM_PROVIDER=claude

# Modo de autenticacao do LLM (Claude): "oauth" (padrao) ou "api_key". So importa
# quando CLIPADOR_TEXT_LLM_PROVIDER=claude.
# - oauth: usa CLAUDE_CODE_OAUTH_TOKEN, consome a cota da assinatura Claude Pro/Max.
# - api_key: usa ANTHROPIC_API_KEY, cobranca pay-per-use direto na API.
CLIPADOR_LLM_AUTH_MODE=oauth

# Token OAuth da assinatura Claude Pro/Max. Gere com `claude setup-token`
# (requer Claude Code instalado e logado na conta Anthropic). Usado quando
# CLIPADOR_TEXT_LLM_PROVIDER=claude e CLIPADOR_LLM_AUTH_MODE=oauth.
CLAUDE_CODE_OAUTH_TOKEN=

# Chave da API da Claude (Anthropic). Obtenha em https://console.anthropic.com/
# Usada quando CLIPADOR_TEXT_LLM_PROVIDER=claude e CLIPADOR_LLM_AUTH_MODE=api_key.
ANTHROPIC_API_KEY=


# Token HuggingFace, so necessario pra diarizacao real via WhisperX(diarize=True).
# Aceite os termos em huggingface.co/pyannote/speaker-diarization-3.1 e
# huggingface.co/pyannote/segmentation-3.0 com a mesma conta.
HUGGINGFACE_TOKEN=

# === Transcricao em nuvem (extra "cloud-transcribe": pip install -e ".[cloud-transcribe]") ===

# OBRIGATORIA para o pipeline rodar com a configuracao padrao: o Scribe v2 e o backend
# de transcricao DEFAULT do projeto desde 2026-09-02 (decisao medida, ver
# .docs/decisions/2026-09-02-transcricao-elevenlabs-scribe.md). Sem a chave, o pipeline
# falha alto em vez de cair calado num backend local de qualidade menor; para rodar
# offline de proposito, passe `--transcriber whisperx` explicitamente.
# Obtenha em https://elevenlabs.io -> menu do perfil (canto inferior esquerdo) -> API Keys
# -> Create API Key. Marque a permissao "Speech to Text" com acesso de escrita; as demais
# podem ficar sem acesso. A chave so aparece UMA vez, no momento da criacao.
ELEVENLABS_API_KEY=

# Chave da AssemblyAI, usada pelo backend `--transcriber assemblyai`.
# Obtenha em https://console.assemblyai.com/
ASSEMBLYAI_API_KEY=

# Chave da API do Gemini (Google). SEMPRE usada pra tratar o fundo/gerar a thumbnail
# com o modelo "Nano Banana" (Gemini Image) - sem ela, a thumbnail cai automaticamente
# pro tratamento local via Pillow (escurece/blur), sem quebrar o pipeline. TAMBEM
# necessaria pra selecao/rerank/metadados quando CLIPADOR_TEXT_LLM_PROVIDER=gemini.
# Obtenha em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo Gemini usado para as etapas de TEXTO quando CLIPADOR_TEXT_LLM_PROVIDER=gemini.
# Opcional: sem definir, usa o default do codigo (gemini-3.1-pro-preview). Nao afeta o
# modelo de IMAGEM da thumbnail, que e fixo em thumbnail/ai_thumbnail.py.
CLIPADOR_GEMINI_TEXT_MODEL=

# === Postagem automatica (extra "publish": pip install -e ".[publish]") ===

# Chave da API do Buffer (https://buffer.com), gerada em Settings > API na
# conta Buffer do usuario. Conta unica: da acesso a todas as orgs/canais dela.
BUFFER_API_KEY=

# IDs dos canais do Buffer usados pra cada grupo (conta conectada) +
# plataforma. Obtenha rodando `clipador-publish buffer-channels` depois de
# configurar BUFFER_API_KEY. A conta Buffer tem 2 grupos de canais: a marca
# "Commit Civico" e os canais pessoais.
BUFFER_CHANNEL_COMMIT_CIVICO_YOUTUBE=
BUFFER_CHANNEL_COMMIT_CIVICO_INSTAGRAM=
BUFFER_CHANNEL_COMMIT_CIVICO_TIKTOK=
BUFFER_CHANNEL_PESSOAL_YOUTUBE=
BUFFER_CHANNEL_PESSOAL_INSTAGRAM=
BUFFER_CHANNEL_PESSOAL_TIKTOK=

# Video staging: servidor HTTP local + tunel ngrok (nada de S3). Requer o binario `ngrok`
# instalado e autenticado (`ngrok config add-authtoken <token>`, plano gratuito serve).
